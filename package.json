{
  "name": "riparo",
  "version": "0.0.1",
  "description": "Monitor npm security advisories, apply the smallest safe patch, verify with no-mistakes, and open a reviewable PR",
  "type": "module",
  "bin": {
    "riparo": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "riparo": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "security",
    "npm",
    "advisories",
    "riparo"
  ],
  "author": "zanuka (Michael Delucchi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanuka/riparo.git"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
